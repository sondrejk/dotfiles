# Gruvbox Dark colors, matching kitty/nvim/wezterm theming across the repo.
set default-bg                 "#282828"
set default-fg                 "#ebdbb2"

set statusbar-fg               "#ebdbb2"
set statusbar-bg               "#3c3836"

set inputbar-bg                "#282828"
set inputbar-fg                "#ebdbb2"

set notification-bg            "#282828"
set notification-fg            "#ebdbb2"
set notification-error-bg      "#282828"
set notification-error-fg      "#fb4934"
set notification-warning-bg    "#282828"
set notification-warning-fg    "#fabd2f"

set completion-bg              "#3c3836"
set completion-fg              "#ebdbb2"
set completion-group-bg        "#282828"
set completion-group-fg        "#928374"
set completion-highlight-bg    "#458588"
set completion-highlight-fg    "#282828"

set index-bg                   "#282828"
set index-fg                   "#ebdbb2"
set index-active-bg            "#458588"
set index-active-fg            "#282828"

set highlight-color             "#fabd2f"
set highlight-active-color      "#fe8019"
set highlight-fg                "#282828"

set recolor                     true
set recolor-lightcolor          "#282828"
set recolor-darkcolor           "#ebdbb2"
set recolor-keephue             true

# Behaviour
set selection-clipboard        clipboard
set window-title-basename      true
set adjust-open                "best-fit"
set pages-per-row              1
set scroll-step                60
set scroll-full-overlap        0.01
set guioptions                 "" # hide the (redundant) GTK toolbar/scrollbars
set statusbar-h-padding        0
set statusbar-v-padding        0
set page-v-padding             1
set page-h-padding             1
set first-page-column          "1:1"
set synctex                    true
